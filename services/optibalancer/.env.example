# Local development template. Copy to .env and replace the credential placeholders.
# Node loads this file only when explicitly passed --env-file; see README.md.
ENV=development
NODE_ENV=development
SERVICE_NAME=optibalancer
LOG_LEVEL=info

# Match the scaler or future HPA observer and the provisioned RabbitMQ queue prefix.
CLUSTER_ID=local-stornx
NAMESPACES=default
PROMETHEUS_URL=http://localhost:9090

# Use this service's own runtime credentials, separate from scaler and setup accounts.
DATABASE_URL=postgres://stornx_balancer:replace-with-balancer-password@localhost:5432/stornx
RABBITMQ_URL=amqp://stornx_balancer:replace-with-balancer-password@localhost:5672

# KUBECONFIG=/absolute/path/to/kubeconfig
# This namespace must exist and allow this process to manage its leadership Lease.
POD_NAMESPACE=stornx
APP_PORT=3002

DRY_RUN=true
MUTATIONS_ENABLED=false
INTERVAL_SECONDS=300
MAX_METRIC_AGE_SECONDS=600
MAX_ATTEMPTS=12

METRICS_TYPE=memory
CPU_WEIGHT=50
MEMORY_WEIGHT=50
# P95 response-time target in milliseconds; routing steps use percentage points.
RESPONSE_TIME_THRESHOLD=100
BALANCER_MIN_DELTA=5
BALANCER_MIN_STEP_SIZE=5
BALANCER_MAX_STEP_SIZE=20
BALANCER_URGENCY_THRESHOLD=50
BALANCER_EPSILON=1

# For production use ENV=production, an AMQPS URL, and verified PostgreSQL TLS.
# DATABASE_CA=/absolute/path/to/database-ca.crt
# RABBITMQ_CA=/absolute/path/to/rabbitmq-ca.crt

# Local development template. Copy to .env and replace the credential placeholders.
# Node loads this file only when explicitly passed --env-file; see README.md.
ENV=development
NODE_ENV=development
SERVICE_NAME=optiscaler
LOG_LEVEL=info

# Both services and event producers must use the same stable cluster identifier.
CLUSTER_ID=local-stornx
NAMESPACES=default
PROMETHEUS_URL=http://localhost:9090

# Provision service-scoped runtime users first; the Compose admin is for setup only.
DATABASE_URL=postgres://stornx_scaler:replace-with-scaler-password@localhost:5432/stornx
RABBITMQ_URL=amqp://stornx_scaler:replace-with-scaler-password@localhost:5672

# Local Kubernetes credentials come from the default kubeconfig, or this optional path.
# KUBECONFIG=/absolute/path/to/kubeconfig
# This namespace must exist and allow this process to manage its leadership Lease.
POD_NAMESPACE=stornx
# Different ports allow both services to run on the same development machine.
APP_PORT=3001

# Keep both guards in their safe states until dependencies and decisions are validated.
DRY_RUN=true
MUTATIONS_ENABLED=false
INTERVAL_SECONDS=300
MAX_METRIC_AGE_SECONDS=600
MAX_ATTEMPTS=12

METRICS_TYPE=memory
CPU_WEIGHT=50
MEMORY_WEIGHT=50
METRICS_LOWER_THRESHOLD=30
METRICS_UPPER_THRESHOLD=80
MIN_REPLICAS=1
MAX_REPLICAS=100
SCALER_COOLDOWN_SECONDS=60
TARGETED_PLACEMENT=true
FT_MAX_ZONES=3

# For production use ENV=production, an AMQPS URL, and verified PostgreSQL TLS.
# Mount private CA files when needed; paths are relative to the working directory.
# DATABASE_CA=/absolute/path/to/database-ca.crt
# RABBITMQ_CA=/absolute/path/to/rabbitmq-ca.crt

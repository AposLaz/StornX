{
  "name": "@stornx/optiscaler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.cjs --runInBand --testPathPattern optiscaler/tests"
  },
  "dependencies": {
    "@stornx/platform": "1.0.0",
    "@stornx/event-contracts": "1.0.0",
    "@kubernetes/client-node": "1.2.0",
    "pg": "8.16.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@types/amqplib": "0.10.7",
    "@types/js-yaml": "4.0.9"
  }
}

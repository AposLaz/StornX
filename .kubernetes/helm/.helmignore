# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Documentation
# README.md is kept in the package so Artifact Hub can display it
CHANGELOG.md

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile

# Testing
tests/
*.test.yaml

# Development files
values-development.yaml

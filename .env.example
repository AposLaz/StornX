# Shared local development defaults. Copy this file to .env if needed.
# Each service still needs its own DATABASE_URL and RABBITMQ_URL:
#   services/optiscaler/.env.example
#   services/optibalancer/.env.example
# Copy those templates to .env beside them and replace credential placeholders.
#
# Load shared defaults first, then the selected service's environment (from repository root):
# node --env-file=.env --env-file=services/optiscaler/.env services/optiscaler/dist/index.js
# node --env-file=.env --env-file=services/optibalancer/.env services/optibalancer/dist/index.js
# Later env files override earlier ones; existing shell variables override both.

ENV=development
NODE_ENV=development
LOG_LEVEL=info

# Keep the same identity across services, event producers, and broker provisioning.
CLUSTER_ID=local-stornx
NAMESPACES=default
PROMETHEUS_URL=http://localhost:9090
POD_NAMESPACE=stornx
# KUBECONFIG=/absolute/path/to/kubeconfig

DRY_RUN=true
MUTATIONS_ENABLED=false
INTERVAL_SECONDS=300
MAX_METRIC_AGE_SECONDS=600
MAX_ATTEMPTS=12

METRICS_TYPE=memory
CPU_WEIGHT=50
MEMORY_WEIGHT=50

# Broker setup: scripts/.env.example
# Integration tests: tests/integration/.env.example
# Production uses Helm values and Kubernetes Secrets; these defaults are for local use.

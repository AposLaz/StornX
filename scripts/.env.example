# Broker provisioning only. Matches deploy/infrastructure/compose.yaml development credentials.
# Copy to scripts/.env and load explicitly; never use these credentials in production.
CLUSTER_ID=local-stornx
BROKER_ADMIN_URL=amqp://local_admin:local-admin-only@localhost:5672
# RABBITMQ_CA=/absolute/path/to/rabbitmq-ca.crt

# import-legacy.mjs uses services/optibalancer/.env instead of this provisioning profile.
# validate-release.mjs receives SERVICE and VERSION from the release workflow.
